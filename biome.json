{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [
      "node",
      "dist",
      "build",
      "coverage",
      "node_modules",
      ".next",
      ".turbo",
      ".github",
      ".react-email",
      "_generated",
      "**/*/fixtures",
      "migrations/meta"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "dev"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "all": true,
      "a11y": {
        "noAutofocus": "off",
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useImportExtensions": "off",
        "noNodejsModules": "off",
        "useExhaustiveDependencies": "off",
        "noUnusedImports": {
          "level": "warn",
          "fix": "safe"
        },
        "noUnusedVariables": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "nursery": {
        "all": true,
        "noCommonJs": "off",
        "noProcessEnv": "off",
        "noSecrets": "off",
        "useComponentExportOnlyModules": "off",
        "useExplicitType": "off",
        "useImportRestrictions": "off",
        "useConsistentCurlyBraces": "off",
        "useStrictMode": "off",
        "noExportedImports": "off",
        "useSortedClasses": {
          "fix": "safe",
          "level": "error",
          "options": {
            "attributes": ["className"],
            "functions": ["clsx", "cva", "tw", "twMerge", "cn", "twJoin"]
          }
        }
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDefaultExport": "off",
        "noImplicitBoolean": "off",
        "noNamespaceImport": "off",
        "useBlockStatements": "off",
        "useExplicitLengthCheck": "off",
        "useSingleVarDeclarator": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noArrayIndexKey": "off"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "formatWithErrors": true
  },
  "organizeImports": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "quoteStyle": "single"
    },
    "globals": [
      "__DEV__",
      "afterEach",
      "afterAll",
      "beforeEach",
      "beforeAll",
      "jest"
    ],
    "jsxRuntime": "reactClassic"
  },
  "css": {
    "formatter": {
      "lineWidth": 80,
      "quoteStyle": "double"
    },
    "parser": {
      "allowWrongLineComments": false,
      "cssModules": false
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 80,
      "trailingCommas": "none"
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  }
}
