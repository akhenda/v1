{
  "extends": ["expo/tsconfig.base", "@v1/typescript/expo.json"],
  "compilerOptions": {
    "strict": true,
    "checkJs": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "@env/*": ["./src/core/constants/config/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
