{
  "name": "@v1/logging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./mobile": {
      "types": "./src/mobile.ts",
      "require": "./dist/mobile.cjs",
      "import": "./dist/mobile.js"
    },
    "./nextjs": {
      "types": "./src/nextjs.ts",
      "require": "./dist/nextjs.cjs",
      "import": "./dist/nextjs.js"
    },
    "./pino": {
      "types": "./src/pino.ts",
      "require": "./dist/pino.cjs",
      "import": "./dist/pino.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logtail/js": "0.5.2",
    "@logtail/next": "0.1.7",
    "@logtail/pino": "0.5.2",
    "@neodx/log": "0.4.1",
    "@rasri/log": "1.3.0",
    "@v1/config": "workspace:*",
    "@v1/release": "workspace:*",
    "@v1/types": "workspace:*",
    "chalk": "4.1.2",
    "error-stack-parser": "2.1.4",
    "pino": "9.5.0",
    "react-native-logs": "5.3.0",
    "remeda": "2.19.0",
    "stack-generator": "2.0.10",
    "unilogr": "0.0.27",
    "universal-logger-pro": "1.2.1"
  },
  "devDependencies": {
    "tsup": "8.3.5"
  }
}
