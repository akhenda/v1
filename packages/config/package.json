{
  "name": "@v1/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsup src --format cjs,esm",
    "build:tsc": "tsc",
    "clean": "rm -rf .turbo dist node_modules coverage",
    "dev": "tsc --watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "release": "semantic-release",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@v1/release": "workspace:*"
  },
  "devDependencies": {
    "@vitest/ui": "2.1.8",
    "tsup": "8.3.5",
    "vitest": "2.1.8"
  }
}
